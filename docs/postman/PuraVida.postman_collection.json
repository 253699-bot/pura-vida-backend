    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Historial de pedidos",
      "item": [
        {
          "name": "Listar mis pedidos",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/my",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "my"
              ]
            },
            "description": "Lista solo los pedidos del cliente autenticado, en orden de fecha descendente."
          },
          "response": []
        },
        {
          "name": "Consultar uno de mis pedidos",
