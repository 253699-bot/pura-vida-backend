# Plantilla para /etc/puravida-api/puravida-api.env en EC2.
# Este archivo es formato .env: sustituye los placeholders y no lo subas al repositorio.
PURAVIDA_DB_URL="jdbc:mysql://TU_HOST:3306/puravida_prod?createDatabaseIfNotExist=false&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
PURAVIDA_DB_USERNAME="CAMBIAR_USUARIO"
PURAVIDA_DB_PASSWORD="CAMBIAR_PASSWORD"
JWT_SECRET="CAMBIAR_SECRET_SEGURO"
JWT_EXPIRATION_MINUTES="120"
